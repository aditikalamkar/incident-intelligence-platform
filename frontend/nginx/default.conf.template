# Serves the dashboard and forwards /api to OpsPilot, so the browser talks to a single origin
# (no CORS). The upstream comes from the OPSPILOT_API_URL environment variable, filled in when
# the container starts.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Component styles are injected at runtime, hence 'unsafe-inline' for styles only
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location /api/ {
        proxy_pass ${OPSPILOT_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Live updates: pass each event through as it arrives. The server sends a heartbeat
        # every 25 seconds, well within the read timeout.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    # File names contain a content hash, so they can be cached for good
    location ~* \.(?:js|css)$ {
        expires 1y;
        try_files $uri =404;
    }

    # Everything else is the single-page app; index.html is never cached, so deploys show up at once
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
